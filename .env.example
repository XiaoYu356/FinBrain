# MySQL配置
MYSQL_ROOT_PASSWORD=root123456

# JWT配置
JWT_SECRET=finbrain-jwt-secret-key-must-be-at-least-256-bits-long-for-security

# 阿里云百炼API Key (必填)
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# LLM 配置
LLM_MODEL=qwen-max
EMBEDDING_MODEL=text-embedding-v1

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Java API 配置
JAVA_API_BASE=http://localhost:8080

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO 配置
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=finbrain-docs

# LangSmith配置 (可选，用于LLM调试和监控)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finbrain
LANGCHAIN_TRACING_V2=true

# HuggingFace 配置
# 使用国内镜像加速模型下载
HF_ENDPOINT=https://hf-mirror.com
# 重排序模型名称
RERANKER_MODEL=BAAI/bge-reranker-base
# 是否在启动时预加载重排序模型（如果内存不足可设为 false）
RERANKER_PRELOAD=true
